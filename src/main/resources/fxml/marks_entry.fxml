<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ac.ruhuna.ftms.controller.MarksController"
            prefWidth="950"
            prefHeight="600"
            minWidth="0"
            minHeight="0">

    <top>

        <VBox spacing="10" minHeight="-Infinity"
              style="-fx-background-color: #1f2937;">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button fx:id="dashboardButton"
                    text="&#8592; Back to Dashboard"
                    onAction="#handleDashboard"
                    minWidth="-Infinity"
                    styleClass="secondary-action"
                    stylesheets="@../css/lecturer_dashboard.css"/>

            <Label text="Marks Entry"
                   style="-fx-text-fill: white;
                          -fx-font-size: 24px;
                          -fx-font-weight: bold;"/>

            <Label text="FTMS - Assessment Marks Management"
                   style="-fx-text-fill: #d1d5db;
                          -fx-font-size: 13px;"/>

        </VBox>

    </top>

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="25"
                        right="30"
                        bottom="25"
                        left="30"/>
            </padding>

            <FlowPane hgap="10" vgap="8">
                <ComboBox fx:id="offeringCombo" promptText="Assigned offering" prefWidth="280"/>
                <ComboBox fx:id="enrollmentCombo" promptText="Student enrollment" prefWidth="280"/>
                <ComboBox fx:id="assessmentCombo" promptText="Assessment" prefWidth="250"/>
                <Label text="Mark status"/><ComboBox fx:id="markStatusCombo"/>
                <Label text="Leave the mark empty for Pending, Absent or Medical."/>
            </FlowPane>
            <GridPane hgap="15"
                      vgap="15">

                <Label text="Enrollment ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="enrollmentIdField"
                           promptText="Example: 101"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Assessment ID"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="assessmentIdField"
                           promptText="Example: 101"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                <Label text="Mark"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="markField"
                           promptText="Enter mark"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Attempt No"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="attemptNoField"
                           text="1"
                           editable="false"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

            </GridPane>

            <FlowPane hgap="10" vgap="8">

                <Button text="Assessments" onAction="#handleAssessments"/><Button text="Refresh" onAction="#handleRefresh"/>
                <Button fx:id="saveButton"
                        text="Save / Update"
                        onAction="#handleSave"
                        prefWidth="130"/>

                <Button fx:id="deleteButton"
                        text="Delete"
                        onAction="#handleDelete"
                        prefWidth="100"/>

                <Button text="Clear"
                        onAction="#handleClear"
                        prefWidth="100"/>

                <Button text="Eligibility"
                        onAction="#handleEligibility"
                        prefWidth="130"/>

                <Button text="Results &amp; Grades"
                        onAction="#handleResults"
                        prefWidth="145"/>

            </FlowPane>

            <TableView fx:id="marksTable"
                       VBox.vgrow="ALWAYS">

                <columns><TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>

                    <TableColumn fx:id="markIdColumn"
                                 text="ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="enrollmentColumn"
                                 text="Enrollment ID"
                                 prefWidth="170"/>

                    <TableColumn fx:id="assessmentColumn"
                                 text="Assessment ID"
                                 prefWidth="170"/>

                    <TableColumn fx:id="markColumn"
                                 text="Mark"
                                 prefWidth="160"/>

                    <TableColumn fx:id="attemptColumn"
                                 text="Attempt"
                                 prefWidth="130"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>
