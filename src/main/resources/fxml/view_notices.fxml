<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ac.ruhuna.ftms.controller.ViewNoticesController">

    <top>
        <VBox spacing="10"
              style="-fx-background-color: #f4f6f9;">
            <padding>
                <Insets top="20" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Faculty Notices"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="View the latest published notices."/>

            <Button text="Refresh Notices"
                    onAction="#handleRefresh"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Published Notices"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="noticeTable"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="titleColumn"
                                 text="Notice Title"
                                 prefWidth="300"/>

                    <TableColumn fx:id="createdAtColumn"
                                 text="Published Date"
                                 prefWidth="200"/>
                </columns>
            </TableView>

            <Label text="Select a notice to read its full content."
                   style="-fx-text-fill: #666666;"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="selectedTitleLabel"
                   text="Select a notice"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TextArea fx:id="contentArea"
                      editable="false"
                      wrapText="true"
                      prefRowCount="5"
                      promptText="Notice content will appear here."/>
        </VBox>
    </bottom>

</BorderPane>