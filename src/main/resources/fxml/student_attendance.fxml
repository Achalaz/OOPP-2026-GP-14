<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ac.ruhuna.ftms.controller.StudentAttendanceController"
            fx:id="studentAttendanceRoot"
            prefWidth="1320.0"
            prefHeight="850.0"
            minWidth="900.0"
            minHeight="620.0"
            style="-fx-background-color: #F3F6FB;">

    <!-- Header -->
    <top>
        <VBox spacing="0">

            <HBox alignment="CENTER_LEFT"
                  spacing="14"
                  style="-fx-background-color: #102C4C;
                         -fx-padding: 20 26 20 26;">

                <VBox spacing="4">

                    <Label text="FTMS / UNDERGRADUATE PORTAL"
                           style="-fx-text-fill: #AFC7E4;
                                  -fx-font-size: 12;
                                  -fx-font-weight: bold;"/>

                    <Label text="My Attendance"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 25;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="studentNameLabel"
                           text="My Attendance"
                           style="-fx-text-fill: #DEEAF8;
                                  -fx-font-size: 13;"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#handleRefresh"
                        style="-fx-background-color: #E8F1FC;
                               -fx-text-fill: #102C4C;
                               -fx-font-weight: bold;
                               -fx-background-radius: 7;
                               -fx-padding: 10 18 10 18;"/>

                <Button fx:id="backButton"
                        text="Back to Dashboard"
                        onAction="#handleBack"
                        style="-fx-background-color: #2E5279;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 7;
                               -fx-padding: 10 16 10 16;"/>

            </HBox>

            <Separator/>

        </VBox>
    </top>

    <!-- Main Content -->
    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #F3F6FB;
                           -fx-background-color: transparent;">

            <content>

                <VBox spacing="20"
                      style="-fx-padding: 24;">

                    <!-- Course Attendance Summary -->
                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 18;
                                 -fx-border-color: #E0E8F2;
                                 -fx-border-radius: 10;">

                        <Label text="Course-wise Attendance Summary"
                               style="-fx-font-size: 19;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #102C4C;"/>

                        <Label
                                text="Theory, Practical and Combined attendance are calculated using PRESENT records only. Medical, Late, Excused and Unmarked sessions are shown separately."
                                wrapText="true"
                                style="-fx-text-fill: #64748B;
                                   -fx-font-size: 12;"/>

                        <TableView fx:id="courseTable"
                                   prefHeight="270"
                                   minHeight="200"
                                   style="-fx-background-color: white;">

                            <columns>

                                <TableColumn
                                        fx:id="courseCodeColumn"
                                        text="Course Code"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="courseNameColumn"
                                        text="Course Name"
                                        prefWidth="225"/>

                                <TableColumn
                                        fx:id="theoryColumn"
                                        text="Theory"
                                        prefWidth="135"/>

                                <TableColumn
                                        fx:id="practicalColumn"
                                        text="Practical"
                                        prefWidth="135"/>

                                <TableColumn
                                        fx:id="combinedColumn"
                                        text="Combined"
                                        prefWidth="140"/>

                                <TableColumn
                                        fx:id="absentColumn"
                                        text="Absent"
                                        prefWidth="75"/>

                                <TableColumn
                                        fx:id="lateColumn"
                                        text="Late"
                                        prefWidth="65"/>

                                <TableColumn
                                        fx:id="excusedColumn"
                                        text="Excused"
                                        prefWidth="75"/>

                                <TableColumn
                                        fx:id="medicalColumn"
                                        text="Medical"
                                        prefWidth="75"/>

                                <TableColumn
                                        fx:id="unmarkedColumn"
                                        text="Unmarked"
                                        prefWidth="90"/>

                            </columns>

                        </TableView>

                        <Label
                                text="Select a course row to see its individual attendance sessions below."
                                style="-fx-text-fill: #64748B;
                                   -fx-font-size: 12;"/>

                    </VBox>

                    <!-- Individual Session Attendance -->
                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-padding: 18;
                                 -fx-border-color: #E0E8F2;
                                 -fx-border-radius: 10;">

                        <Label text="Individual Attendance Sessions"
                               style="-fx-font-size: 19;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #102C4C;"/>

                        <Label fx:id="courseDetailsLabel"
                               text="Select a course to view attendance."
                               wrapText="true"
                               style="-fx-text-fill: #475569;
                                      -fx-font-size: 13;"/>

                        <TableView fx:id="sessionTable"
                                   prefHeight="250"
                                   minHeight="200"
                                   style="-fx-background-color: white;">

                            <columns>

                                <TableColumn
                                        fx:id="sessionDateColumn"
                                        text="Date"
                                        prefWidth="125"/>

                                <TableColumn
                                        fx:id="sessionTypeColumn"
                                        text="Session Type"
                                        prefWidth="135"/>

                                <TableColumn
                                        fx:id="sessionTimeColumn"
                                        text="Time"
                                        prefWidth="165"/>

                                <TableColumn
                                        fx:id="sessionTopicColumn"
                                        text="Topic"
                                        prefWidth="470"/>

                                <TableColumn
                                        fx:id="sessionStatusColumn"
                                        text="Attendance Status"
                                        prefWidth="160"/>

                            </columns>

                        </TableView>

                        <Label
                                text="This page is read-only. Attendance corrections must be handled by authorized staff."
                                wrapText="true"
                                style="-fx-text-fill: #64748B;
                                   -fx-font-size: 12;"/>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <!-- Bottom Status Bar -->
    <bottom>

        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 12 24 12 24;
                     -fx-background-color: #E8EFF7;">

            <Label fx:id="statusLabel"
                   text="Loading attendance..."
                   wrapText="true"
                   style="-fx-text-fill: #334155;
                          -fx-font-size: 12;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="STUDENT VIEW ONLY"
                   style="-fx-text-fill: #64748B;
                          -fx-font-size: 11;
                          -fx-font-weight: bold;"/>

        </HBox>

    </bottom>

</BorderPane>
