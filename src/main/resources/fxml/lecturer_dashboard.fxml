<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="lk.ac.ruhuna.ftms.controller.LecturerDashboardController"
        fx:id="lecturerRoot"
        stylesheets="@../css/lecturer_dashboard.css"
        prefWidth="1250"
        prefHeight="800">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="255" minWidth="255" maxWidth="255" styleClass="sidebar" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="F" styleClass="brand-icon"/>
                <VBox spacing="3">
                    <Label text="FTMS" styleClass="brand-title"/>
                    <Label text="LECTURER PORTAL" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Separator/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" VBox.vgrow="ALWAYS" styleClass="sidebar-scroll">
                <content>
                    <VBox spacing="5">
                        <Label text="WORKSPACE" styleClass="sidebar-heading"/>
                        <Button text="  Dashboard" styleClass="nav-button,nav-active" maxWidth="Infinity" onAction="#handleDashboard"/>
                        <Button text="  My Profile" styleClass="nav-button" maxWidth="Infinity" onAction="#handleProfile"/>
                        <Label text="ASSESSMENTS AND RESULTS" styleClass="sidebar-heading"/>
                        <Button id="assessmentsNav" text="  Assessments" styleClass="nav-button" maxWidth="Infinity" onAction="#handleAssessments"/>
                        <Button id="marksNav" text="  Upload Exam Marks" styleClass="nav-button" maxWidth="Infinity" onAction="#handleUploadMarks"/>
                        <Button id="eligibilityNav" text="  Student Eligibility" styleClass="nav-button" maxWidth="Infinity" onAction="#handleEligibility"/>
                        <Button id="resultsNav" text="  Result Publication" styleClass="nav-button" maxWidth="Infinity" onAction="#handleResults"/>
                        <Button id="gpaNav" text="  SGPA / CGPA" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGPA"/>
                        <Button id="reportsNav" text="  Academic Reports" styleClass="nav-button" maxWidth="Infinity" onAction="#handleAcademicReports"/>
                        <Label text="TEACHING AND SUPPORT" styleClass="sidebar-heading"/>
                        <Button text="  Course Materials" styleClass="nav-button" maxWidth="Infinity" onAction="#handleCourseMaterials"/>
                        <Button text="  Undergraduates" styleClass="nav-button" maxWidth="Infinity" onAction="#handleStudentDetails"/>
                        <Button text="  Attendance Records" styleClass="nav-button" maxWidth="Infinity" onAction="#handleAttendance"/>
                        <Button text="  Medical Records" styleClass="nav-button" maxWidth="Infinity" onAction="#handleMedical"/>
                        <Button text="  Notices" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNotices"/>
                    </VBox>
                </content>
            </ScrollPane>
            <Separator/>
            <Label fx:id="usernameLabel" text="Lecturer" wrapText="true" styleClass="sidebar-user"/>
            <Button text="Log Out" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="page-scroll">

            <content>
                <VBox spacing="22" styleClass="main-content">

                    <!-- HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox spacing="5">
                            <Label text="LECTURER / OVERVIEW"
                                   styleClass="eyebrow"/>

                            <Label text="Lecturer Dashboard"
                                   styleClass="page-title"/>

                            <Label text="Faculty Technology Management System"
                                   styleClass="page-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="dateLabel"
                               styleClass="date-label"/>
                    </HBox>

                    <!-- WELCOME BANNER -->
                    <VBox spacing="10" styleClass="welcome-banner">

                        <Label text="ACADEMIC WORKSPACE"
                               styleClass="welcome-tag"/>

                        <Label fx:id="welcomeLabel"
                               text="Welcome back, Lecturer!"
                               wrapText="true"
                               styleClass="welcome-title"/>

                        <Label
                                text="Manage teaching activities and access student academic information from one place."
                                wrapText="true"
                                styleClass="welcome-description"/>

                    </VBox>

                    <VBox spacing="5">
                        <Label text="Assessments and Results" styleClass="section-title"/>
                        <Label text="Follow the academic workflow for your assigned course offerings." wrapText="true" styleClass="section-subtitle"/>
                    </VBox>
                    <TilePane id="academicFeatures" hgap="18" vgap="18" prefTileWidth="335" prefTileHeight="220">
                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="AS" styleClass="feature-icon"/>
                            <Label text="Assessments" styleClass="card-title"/>
                            <Label text="Set up assessment types, maximum marks and weights for assigned courses." wrapText="true" styleClass="card-description"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button id="assessmentsCard" text="Manage Assessments" styleClass="primary-action" onAction="#handleAssessments"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="MK" styleClass="feature-icon"/>

                            <Label text="Exam Marks"
                                   styleClass="card-title"/>

                            <Label
                                    text="Enter and update assessment and exam marks."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button id="marksCard" text="Upload Marks"
                                    styleClass="primary-action"
                                    onAction="#handleUploadMarks"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="EL" styleClass="feature-icon"/>

                            <Label text="Student Eligibility"
                                   styleClass="card-title"/>

                            <Label
                                    text="Review students' academic and examination eligibility."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button id="eligibilityCard" text="View Eligibility"
                                    styleClass="primary-action"
                                    onAction="#handleEligibility"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="RS" styleClass="feature-icon"/>
                            <Label text="Result Publication" styleClass="card-title"/>
                            <Label text="Calculate results, review saved drafts and publish valid results." wrapText="true" styleClass="card-description"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button id="resultsCard" text="Review and Publish" styleClass="primary-action" onAction="#handleResults"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="GP" styleClass="feature-icon"/>
                            <Label text="SGPA / CGPA" styleClass="card-title"/>
                            <Label text="Review credit-weighted semester and cumulative GPA from published results." wrapText="true" styleClass="card-description"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button id="gpaCard" text="View GPA" styleClass="primary-action" onAction="#handleGPA"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="RP" styleClass="feature-icon"/>
                            <Label text="Academic Reports" styleClass="card-title"/>
                            <Label text="View individual student, batch and course offering result reports." wrapText="true" styleClass="card-description"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button id="reportsCard" text="View Reports" styleClass="primary-action" onAction="#handleAcademicReports"/>
                        </VBox>
                    </TilePane>

                    <VBox spacing="5">
                        <Label text="Teaching and Student Support" styleClass="section-title"/>
                        <Label text="Your profile, course materials and student records." wrapText="true" styleClass="section-subtitle"/>
                    </VBox>
                    <TilePane hgap="18" vgap="18" prefTileWidth="335" prefTileHeight="220">
                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="PR" styleClass="feature-icon"/>

                            <Label text="My Profile"
                                   styleClass="card-title"/>

                            <Label
                                    text="Update your name, email and profile picture."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Edit Profile"
                                    styleClass="primary-action"
                                    onAction="#handleProfile"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="CM" styleClass="feature-icon"/>

                            <Label text="Course Materials"
                                   styleClass="card-title"/>

                            <Label
                                    text="Add, modify and manage learning materials."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Manage Materials"
                                    styleClass="primary-action"
                                    onAction="#handleCourseMaterials"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="ST" styleClass="feature-icon"/>

                            <Label text="Undergraduates"
                                   styleClass="card-title"/>

                            <Label
                                    text="View undergraduate details and student profiles."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="View Students"
                                    styleClass="primary-action"
                                    onAction="#handleStudentDetails"/>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="AM" styleClass="feature-icon"/>

                            <Label text="Attendance and Medical"
                                   styleClass="card-title"/>

                            <Label
                                    text="Review undergraduate attendance and medical records."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <HBox spacing="9">
                                <Button text="Attendance"
                                        styleClass="primary-action"
                                        onAction="#handleAttendance"/>

                                <Button text="Medical"
                                        styleClass="secondary-action"
                                        onAction="#handleMedical"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="feature-card" spacing="10">
                            <Label text="NT" styleClass="feature-icon"/>

                            <Label text="Notices"
                                   styleClass="card-title"/>

                            <Label
                                    text="Read published faculty notices and announcements."
                                    wrapText="true"
                                    styleClass="card-description"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="View Notices"
                                    styleClass="primary-action"
                                    onAction="#handleNotices"/>
                        </VBox>
                    </TilePane>

                    <Label
                            text="FTMS | Faculty Technology Management System"
                            styleClass="footer-label"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
