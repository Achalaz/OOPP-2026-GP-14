<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ac.ruhuna.ftms.controller.CourseMaterialsController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="18" right="18" bottom="12" left="18"/>
            </padding>

            <Label text="Course Materials"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <HBox spacing="8">
                <TextField fx:id="searchField"
                           promptText="Search by title or description..."
                           onAction="#handleSearch"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        onAction="#handleSearch"/>

                <Button text="Refresh"
                        onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="materialsTable"
                   prefHeight="300"
                   columnResizePolicy="CONSTRAINED_RESIZE_POLICY">

            <columns>
                <TableColumn fx:id="offeringColumn"
                             text="Offering"
                             prefWidth="85"/>

                <TableColumn fx:id="titleColumn"
                             text="Title"
                             prefWidth="150"/>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="110"/>

                <TableColumn fx:id="descriptionColumn"
                             text="Description"
                             prefWidth="160"/>

                <TableColumn fx:id="resourcePathColumn"
                             text="Resource Path / URL"
                             prefWidth="180"/>

                <TableColumn fx:id="uploadedAtColumn"
                             text="Uploaded At"
                             prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="12">
            <padding>
                <Insets top="14" right="18" bottom="18" left="18"/>
            </padding>

            <Label text="Add / Edit Material"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Course Offering"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="offeringCombo"
                          promptText="Select assigned offering"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Title"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="titleField"
                           promptText="Enter material title"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Material Type"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="materialTypeCombo"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Description"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextArea fx:id="descriptionArea"
                          promptText="Optional description"
                          prefRowCount="2"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Label text="Resource Path / URL"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="resourcePathField"
                           promptText="Enter file path or URL"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>
            </GridPane>

            <HBox spacing="10">
                <Button fx:id="saveButton"
                        text="Save Material"
                        onAction="#handleSave"
                        defaultButton="true"/>

                <Button text="Clear Form"
                        onAction="#handleClear"/>

                <Button text="Delete Selected"
                        onAction="#handleDelete"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
