<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="noticesRoot" fx:controller="lk.ac.ruhuna.ftms.controller.NoticeController"
            prefWidth="1100" prefHeight="700" minWidth="0"
            style="-fx-background-color: #f4f8fc; -fx-font-family: 'Segoe UI';">
    <top>
        <VBox spacing="8" style="-fx-background-color: #102b4e; -fx-padding: 16 24;">
            <Button text="Back to Admin Dashboard" onAction="#handleBack"/>
            <Label text="Notice Management" wrapText="true"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Create, edit and publish faculty notices. Drafts are visible only to administrators."
                   wrapText="true" style="-fx-text-fill: #cbdcf0;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0">
            <VBox spacing="14" minWidth="0">
                <padding><Insets top="18" right="24" bottom="20" left="24"/></padding>
                <VBox spacing="10" minWidth="0">
                    <TextField fx:id="searchField" promptText="Search notices by title or content..."
                               onAction="#handleSearch"/>
                    <FlowPane hgap="10" vgap="8">
                        <Button text="Search" onAction="#handleSearch"/>
                        <Button text="Show All / Refresh" onAction="#handleShowAll"/>
                    </FlowPane>
                    <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #102b4e;"/>
                    <TableView fx:id="noticeTable" minWidth="0" prefHeight="210" minHeight="150">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="55" minWidth="45"/>
                            <TableColumn fx:id="titleColumn" text="Title" prefWidth="220" minWidth="100"/>
                            <TableColumn fx:id="contentColumn" text="Content" prefWidth="300" minWidth="100"/>
                            <TableColumn fx:id="audienceColumn" text="Audience" prefWidth="150" minWidth="110"/>
                            <TableColumn fx:id="publishedColumn" text="Status" prefWidth="120" minWidth="110"/>
                            <TableColumn fx:id="publishedAtColumn" text="Publication start" prefWidth="180" minWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox spacing="10" minWidth="0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18;">
                    <Label fx:id="formHeading" text="Create a notice"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #102b4e;"/>
                    <Label text="Title"/>
                    <TextField fx:id="titleField" promptText="Enter notice title (maximum 180 characters)"/>
                    <Label text="Content"/>
                    <TextArea fx:id="contentField" promptText="Enter the full notice..."
                              prefRowCount="4" wrapText="true"/>
                    <Label text="Audience"/>
                    <ComboBox fx:id="audienceCombo" maxWidth="Infinity"/>
                    <Label text="Publication start (yyyy-MM-dd HH:mm:ss)"/>
                    <TextField fx:id="publishedAtField" promptText="New notices: leave blank to use the current database time"/>
                    <Label text="Expiry (optional, yyyy-MM-dd HH:mm:ss)"/>
                    <TextField fx:id="expiresAtField" promptText="Leave blank for no expiry"/>
                    <CheckBox fx:id="publishedCheckBox" text="Enable publication (unchecked = draft / inactive)"/>
                    <Label text="Published notices appear only within their date window and to their selected audience. Publish / Unpublish preserves these dates."
                           wrapText="true" style="-fx-text-fill: #52657b;"/>
                    <FlowPane hgap="10" vgap="8">
                        <Button fx:id="saveButton" text="Save Notice" onAction="#handleSave"
                                style="-fx-background-color: #102b4e; -fx-text-fill: white;"/>
                        <Button text="New / Clear" onAction="#handleClear"/>
                        <Button fx:id="editButton" text="Edit Selected" onAction="#handleEdit"/>
                        <Button fx:id="publishButton" text="Publish / Unpublish" onAction="#handlePublishToggle"/>
                        <Button fx:id="deleteButton" text="Delete Notice" onAction="#handleDelete"
                                style="-fx-background-color: #b91c1c; -fx-text-fill: white;"/>
                    </FlowPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
