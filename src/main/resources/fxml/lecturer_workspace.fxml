<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="lk.ac.ruhuna.ftms.controller.LecturerWorkspaceController"
      fx:id="workspaceRoot" prefWidth="1200" prefHeight="800" minWidth="0" minHeight="0" spacing="18" styleClass="main-content" stylesheets="@../css/lecturer_dashboard.css">
 <FlowPane hgap="12" vgap="8" minHeight="-Infinity">
   <Button fx:id="dashboardButton" text="&#8592; Back to Dashboard" onAction="#dashboard" styleClass="secondary-action" minWidth="-Infinity"/>
   <Button text="Log Out" onAction="#logout" styleClass="logout-button" minWidth="-Infinity"/>
 </FlowPane>
 <Label fx:id="heading" styleClass="page-title"/>
 <HBox spacing="12"><ComboBox fx:id="offering" promptText="Choose assigned course" prefWidth="620"/><Button fx:id="refresh" text="Refresh" onAction="#reload"/><TextField fx:id="search" promptText="Search displayed records" HBox.hgrow="ALWAYS"/></HBox>
 <Label fx:id="message" wrapText="true"/>
 <TableView fx:id="table" VBox.vgrow="ALWAYS"><placeholder><Label text="Choose a course to load records."/></placeholder></TableView>
 <HBox fx:id="markEditor" spacing="12"><Label text="Mark for selected assessment"/><TextField fx:id="markValue" promptText="Blank = Pending"/><Button text="Save Mark" onAction="#saveMark" styleClass="primary-action"/></HBox>
 <VBox fx:id="materialEditor" spacing="14" styleClass="feature-card" VBox.vgrow="ALWAYS">
   <Label text="Select a material to view or edit" styleClass="section-title"/>
   <TableView fx:id="materialTable" prefHeight="200" minHeight="100" VBox.vgrow="ALWAYS">
     <placeholder><Label text="No materials to display. Choose an offering or clear your search."/></placeholder>
   </TableView>
   <ComboBox fx:id="materials" maxWidth="Infinity" promptText="Existing materials"/>
   <Label fx:id="materialDetails" wrapText="true"/>
   <HBox spacing="12"><Button text="New Material" onAction="#newMaterial"/><Button text="Download Selected" onAction="#download"/></HBox>
   <TextField fx:id="materialTitle" promptText="Material title"/>
   <ComboBox fx:id="materialType" promptText="Material type"/>
   <TextArea fx:id="description" promptText="Description" prefRowCount="4" wrapText="true"/>
   <HBox spacing="12"><Button fx:id="chooseFileButton" text="Choose File" onAction="#chooseFile"/><Label fx:id="fileLabel" text="No file selected"/></HBox>
   <Button fx:id="saveMaterialButton" text="Save Material" onAction="#saveMaterial" styleClass="primary-action"/>
 </VBox>
</VBox>
