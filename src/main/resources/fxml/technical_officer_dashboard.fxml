<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- Scene Builder can inspect this layout without running its controller.
     The application always requires an authenticated TECHNICAL_OFFICER session. -->
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ac.ruhuna.ftms.controller.TechnicalOfficerDashboardController"
            fx:id="technicalOfficerRoot" styleClass="technical-officer-dashboard"
            stylesheets="@../css/technical_officer_dashboard.css"
            prefWidth="1100" prefHeight="690" minWidth="0" minHeight="0">
    <left>
        <VBox prefWidth="244" minWidth="244" maxWidth="244" styleClass="officer-sidebar">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="sidebar-brand">
                <StackPane styleClass="brand-mark" minWidth="40" minHeight="40" maxWidth="40" maxHeight="40">
                    <SVGPath styleClass="brand-symbol" content="M2 9 L12 3 L22 9 Z M5 11 V20 M10 11 V20 M15 11 V20 M20 11 V20 M2 22 H22"/>
                </StackPane>
                <VBox spacing="2" minWidth="0">
                    <Label text="FTMS" styleClass="brand-title"/>
                    <Label text="Technical Officer Portal" wrapText="true" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Separator styleClass="sidebar-divider"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" minHeight="0" styleClass="sidebar-scroll">
                <content>
                    <VBox spacing="6" styleClass="sidebar-navigation">
                        <Label text="YOUR WORKSPACE" styleClass="sidebar-caption"/>
                        <Button text="Dashboard" onAction="#handleDashboard" maxWidth="Infinity" styleClass="nav-button,nav-active">
                            <graphic><SVGPath styleClass="nav-icon" content="M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M3 14 H10 V21 H3 Z M14 14 H21 V21 H14 Z"/></graphic>
                        </Button>
                        <Button text="My Profile" onAction="#handleProfile" maxWidth="Infinity" styleClass="nav-button">
                            <graphic><SVGPath styleClass="nav-icon" content="M16 7 A4 4 0 1 1 8 7 A4 4 0 1 1 16 7 M4 21 V19 C4 12 20 12 20 19 V21"/></graphic>
                        </Button>
                        <Button text="Attendance Management" onAction="#handleAttendance" maxWidth="Infinity" styleClass="nav-button">
                            <graphic><SVGPath styleClass="nav-icon" content="M7 4 H4 V22 H20 V4 H17 M8 2 H16 V6 H8 Z M8 14 L11 17 L16 11"/></graphic>
                        </Button>
                        <Button text="Medical Management" onAction="#handleMedical" maxWidth="Infinity" styleClass="nav-button">
                            <graphic><SVGPath styleClass="nav-icon" content="M9 3 H15 V9 H21 V15 H15 V21 H9 V15 H3 V9 H9 Z"/></graphic>
                        </Button>
                        <Button text="Notices" onAction="#handleNotices" maxWidth="Infinity" styleClass="nav-button">
                            <graphic><SVGPath styleClass="nav-icon" content="M3 10 L20 4 V20 L3 14 Z M6 15 L8 22 H12 L10 16 M20 9 H23 V15 H20"/></graphic>
                        </Button>
                        <Button text="Department Timetable" onAction="#handleTimetable" maxWidth="Infinity" styleClass="nav-button">
                            <graphic><SVGPath styleClass="nav-icon" content="M3 5 H21 V21 H3 Z M7 2 V8 M17 2 V8 M3 11 H21 M7 15 H10 M14 15 H17"/></graphic>
                        </Button>
                    </VBox>
                </content>
            </ScrollPane>
            <VBox spacing="14" styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-divider"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36" styleClass="officer-avatar">
                        <Label fx:id="avatarLabel" text="T" styleClass="avatar-letter"/>
                    </StackPane>
                    <VBox spacing="3" minWidth="0" HBox.hgrow="ALWAYS">
                        <Label fx:id="officerNameLabel" text="Technical Officer" wrapText="true" maxWidth="Infinity" styleClass="sidebar-name"/>
                        <Label text="TECHNICAL OFFICER" styleClass="sidebar-role"/>
                    </VBox>
                </HBox>
                <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="logout-button">
                    <graphic><SVGPath styleClass="logout-icon" content="M9 3 H3 V21 H9 M8 12 H22 M17 7 L22 12 L17 17"/></graphic>
                </Button>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" minHeight="0"
                    prefViewportWidth="856" styleClass="dashboard-scroll">
            <content>
                <VBox spacing="24" minWidth="0" styleClass="dashboard-content">
                    <VBox spacing="12" minWidth="0">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="UNIVERSITY OF RUHUNA" wrapText="true" styleClass="university-label" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
                            <Label fx:id="dateLabel" text="Current date" styleClass="date-label" minWidth="-Infinity"/>
                        </HBox>
                        <VBox spacing="6" minWidth="0">
                            <Label text="Technical Officer Dashboard" wrapText="true" maxWidth="Infinity" styleClass="page-title"/>
                            <Label text="Supporting students. Connecting your department." wrapText="true" styleClass="page-subtitle"/>
                        </VBox>
                    </VBox>

                    <StackPane minWidth="0" styleClass="welcome-banner">
                        <SVGPath content="M15 42 L75 10 L135 42 Z M25 52 H125 M32 60 V108 M58 60 V108 M92 60 V108 M118 60 V108 M18 118 H132 M9 130 H141"
                                 styleClass="campus-illustration" StackPane.alignment="CENTER_RIGHT" mouseTransparent="true"/>
                        <VBox spacing="12" minWidth="0">
                            <Label text="FACULTY SUPPORT, ALL IN ONE PLACE" wrapText="true" styleClass="welcome-eyebrow"/>
                            <Label fx:id="nameLabel" text="Welcome back, Technical Officer!" wrapText="true" maxWidth="Infinity" styleClass="welcome-title"/>
                            <Label text="Your workspace for student support and department coordination. Keep everyday faculty responsibilities within reach."
                                   maxWidth="480" wrapText="true" styleClass="welcome-description"/>
                            <FlowPane hgap="10" vgap="8" styleClass="welcome-details">
                                <Label text="TECHNICAL OFFICER" styleClass="welcome-chip"/>
                                <Label text="Department —" styleClass="department-label"/>
                            </FlowPane>
                        </VBox>
                    </StackPane>

                    <VBox spacing="5" minWidth="0">
                        <Label text="Your faculty workspace" wrapText="true" styleClass="section-title"/>
                        <Label text="Personal details, student support and department essentials." wrapText="true" styleClass="section-description"/>
                    </VBox>

                    <GridPane fx:id="featureGrid" hgap="16" vgap="16" minWidth="0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="feature-card,profile-card">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <StackPane styleClass="card-icon"><SVGPath content="M16 7 A4 4 0 1 1 8 7 A4 4 0 1 1 16 7 M4 21 V19 C4 12 20 12 20 19 V21"/></StackPane>
                                <Region HBox.hgrow="ALWAYS"/><Label text="MY ACCOUNT" styleClass="account-badge"/>
                            </HBox>
                            <Label text="My Profile" wrapText="true" styleClass="card-title"/>
                            <Label text="View and update personal profile details." wrapText="true" styleClass="card-description" VBox.vgrow="ALWAYS" maxHeight="Infinity"/>
                            <Button text="My Profile" onAction="#handleProfile" maxWidth="Infinity" styleClass="card-button,primary-card-button"/>
                        </VBox>
                        <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="feature-card,attendance-card" GridPane.columnIndex="1">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <StackPane styleClass="card-icon"><SVGPath content="M7 4 H4 V22 H20 V4 H17 M8 2 H16 V6 H8 Z M8 14 L11 17 L16 11"/></StackPane>
                                <Region HBox.hgrow="ALWAYS"/><Label text="COMING SOON" styleClass="coming-soon"/>
                            </HBox>
                            <Label text="Attendance Management" wrapText="true" styleClass="card-title"/>
                            <Label text="Add, view and maintain undergraduate attendance." wrapText="true" styleClass="card-description" VBox.vgrow="ALWAYS" maxHeight="Infinity"/>
                            <Button text="Manage Attendance" onAction="#handleAttendance" maxWidth="Infinity" styleClass="card-button"/>
                        </VBox>
                        <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="feature-card,medical-card" GridPane.rowIndex="1">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <StackPane styleClass="card-icon"><SVGPath content="M9 3 H15 V9 H21 V15 H15 V21 H9 V15 H3 V9 H9 Z"/></StackPane>
                                <Region HBox.hgrow="ALWAYS"/><Label text="COMING SOON" styleClass="coming-soon"/>
                            </HBox>
                            <Label text="Medical Management" wrapText="true" styleClass="card-title"/>
                            <Label text="Add, view and maintain undergraduate medical records." wrapText="true" styleClass="card-description" VBox.vgrow="ALWAYS" maxHeight="Infinity"/>
                            <Button text="Manage Medical" onAction="#handleMedical" maxWidth="Infinity" styleClass="card-button"/>
                        </VBox>
                        <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="feature-card,notices-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <StackPane styleClass="card-icon"><SVGPath content="M3 10 L20 4 V20 L3 14 Z M6 15 L8 22 H12 L10 16 M20 9 H23 V15 H20"/></StackPane>
                                <Region HBox.hgrow="ALWAYS"/><Label text="COMING SOON" styleClass="coming-soon"/>
                            </HBox>
                            <Label text="Notices" wrapText="true" styleClass="card-title"/>
                            <Label text="View published faculty notices." wrapText="true" styleClass="card-description" VBox.vgrow="ALWAYS" maxHeight="Infinity"/>
                            <Button text="View Notices" onAction="#handleNotices" maxWidth="Infinity" styleClass="card-button"/>
                        </VBox>
                        <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="feature-card,timetable-card" GridPane.rowIndex="2">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <StackPane styleClass="card-icon"><SVGPath content="M3 5 H21 V21 H3 Z M7 2 V8 M17 2 V8 M3 11 H21 M7 15 H10 M14 15 H17"/></StackPane>
                                <Region HBox.hgrow="ALWAYS"/><Label text="COMING SOON" styleClass="coming-soon"/>
                            </HBox>
                            <Label text="Department Timetable" wrapText="true" styleClass="card-title"/>
                            <Label text="View academic timetables for the assigned department." wrapText="true" styleClass="card-description" VBox.vgrow="ALWAYS" maxHeight="Infinity"/>
                            <Button text="View Timetable" onAction="#handleTimetable" maxWidth="Infinity" styleClass="card-button"/>
                        </VBox>
                    </GridPane>
                    <VBox spacing="8" styleClass="dashboard-footer">
                        <Separator/>
                        <Label fx:id="statusLabel" text="Your faculty workspace. Select a service to get started." wrapText="true" styleClass="status-label"/>
                        <Label text="FTMS  /  Faculty of Technology  /  University of Ruhuna" wrapText="true" styleClass="footer-label"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
