<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<BorderPane minWidth="0" minHeight="0" xmlns:fx="http://javafx.com/fxml" fx:controller="lk.ac.ruhuna.ftms.controller.AssessmentsController" prefWidth="1000" prefHeight="750">
 <top><VBox spacing="10" style="-fx-background-color:#1f2937;-fx-padding:20;">
  <Button id="dashboardButton" minWidth="-Infinity" text="&#8592; Back to Dashboard" onAction="#handleDashboard"/>
  <Button text="Marks Entry" onAction="#handleBack"/>
  <Label text="Assessment Management" style="-fx-text-fill:white;-fx-font-size:24;"/>
 </VBox></top>
 <center><VBox spacing="12" style="-fx-padding:20;">
  <ComboBox fx:id="offeringCombo" promptText="Select your assigned course offering" maxWidth="Infinity"/>
  <GridPane hgap="12" vgap="12">
   <Label text="Name" GridPane.rowIndex="0"/><TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
   <Label text="Type" GridPane.columnIndex="2" GridPane.rowIndex="0"/><ComboBox fx:id="typeCombo" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
   <Label text="Maximum" GridPane.rowIndex="1"/><TextField fx:id="maxField" text="100" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
   <Label text="Weight %" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="weightField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
   <Label text="Date" GridPane.rowIndex="2"/><DatePicker fx:id="dateField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
   <Label text="Description" GridPane.columnIndex="2" GridPane.rowIndex="2"/><TextArea fx:id="descriptionField" prefRowCount="2" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
  </GridPane>
  <FlowPane hgap="10" vgap="8">
   <Button fx:id="newButton" text="New / Clear" onAction="#handleNew"/><Button fx:id="saveButton" text="Save Assessment" onAction="#handleSave"/>
   <Button fx:id="deleteButton" text="Delete Unreferenced Assessment" onAction="#handleDelete"/>
   <Button fx:id="releaseButton" text="Release Assessment" onAction="#handleRelease" disable="true"/>
   <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
  </FlowPane>
  <Label fx:id="statusLabel" wrapText="true" text="Build a complete assessment plan before calculating results."/>
  <TableView fx:id="assessmentTable" VBox.vgrow="ALWAYS"><columns>
   <TableColumn fx:id="nameColumn" text="Assessment" prefWidth="280"/><TableColumn fx:id="typeColumn" text="Type" prefWidth="180"/>
   <TableColumn fx:id="maxColumn" text="Maximum mark" prefWidth="150"/><TableColumn fx:id="weightColumn" text="Weight %" prefWidth="150"/>
   <TableColumn fx:id="publicationColumn" text="Status" prefWidth="100"/>
   <TableColumn fx:id="publishedAtColumn" text="Released at" prefWidth="180"/>
  </columns></TableView>
 </VBox></center>
</BorderPane>
