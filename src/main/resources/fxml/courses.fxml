<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="coursesRoot" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ac.ruhuna.ftms.controller.CourseController"
            prefWidth="1100"
            prefHeight="700">

    <top>
        <VBox spacing="10" style="-fx-padding: 16;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Course Management"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="dashboardButton" text="Back to Dashboard"
                        onAction="#handleBackToDashboard"/>
            </HBox>

            <HBox spacing="8">
                <TextField fx:id="searchField"
                           promptText="Search by course code or name"
                           onAction="#handleSearch"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        onAction="#handleSearch"/>

                <Button text="Show All"
                        onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="courseTable" minHeight="120">
            <columns>
                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="codeColumn"
                             text="Course Code"
                             prefWidth="120"/>

                <TableColumn fx:id="nameColumn"
                             text="Course Name"
                             prefWidth="230"/>

                <TableColumn fx:id="creditsColumn"
                             text="Credits"
                             prefWidth="80"/>

                <TableColumn fx:id="departmentColumn"
                             text="Department ID"
                             prefWidth="110"/>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="110"/>

                <TableColumn fx:id="activeColumn"
                             text="Active"
                             prefWidth="80"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="12" style="-fx-padding: 16;">
            <Label text="Course Details"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="35"/>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="35"/>
                </columnConstraints>
                <Label text="Course Code:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="courseCodeField"
                           promptText="e.g. ICT101"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Course Name:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="courseNameField"
                           promptText="Enter course name"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                <Label text="Credits:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="creditsField"
                           promptText="e.g. 3.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Department ID:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="departmentIdField"
                           promptText="Enter department ID"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="Course Type:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="courseTypeComboBox"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Status:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <CheckBox fx:id="activeCheckBox"
                          text="Active"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="2"/>
            </GridPane>

            <FlowPane hgap="10" vgap="8">
                <Button text="Add Course"
                        onAction="#handleAdd"/>

                <Button text="Update Course"
                        onAction="#handleUpdate"/>

                <Button text="Delete Course"
                        onAction="#handleDelete"/>

                <Button text="Clear Form"
                        onAction="#handleClear"/>
            </FlowPane>
        </VBox>
    </bottom>

</BorderPane>
