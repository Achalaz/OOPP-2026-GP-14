<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="adminRoot" xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ac.ruhuna.ftms.controller.AdminDashboardController"
            stylesheets="@../css/admin_dashboard.css"
            prefWidth="1200"
            prefHeight="750">

    <left>
        <ScrollPane fitToWidth="true" fitToHeight="true" prefWidth="245"
                    hbarPolicy="NEVER" style="-fx-background-color: #142B4E; -fx-padding: 0;">
        <VBox prefWidth="245" styleClass="sidebar">

            <Label text="FTMS" styleClass="brand-title"/>
            <Label text="FACULTY ADMINISTRATION"
                   styleClass="brand-subtitle"/>

            <Separator/>

            <Button text="⌂  Dashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button,nav-active"
                    onAction="#handleDashboard"/>

            <Button text="☷  User Profiles"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#handleUsers"/>

            <Button text="▣  Courses"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#handleCourses"/>

            <Button text="▤  Course Offerings"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#handleCourseOfferings"/>

            <Button text="Student Enrollments" maxWidth="Infinity"
                    styleClass="nav-button" onAction="#handleEnrollments"/>

            <Button id="gpaNavButton" text="SGPA / CGPA Management" maxWidth="Infinity"
                    styleClass="nav-button" onAction="#handleGpa"/>

            <Button text="✉  Notices"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#handleNotices"/>

            <Button text="▦  Timetables"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#handleTimetables"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="profileButton" text="My Profile"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#handleProfile"/>

            <Button text="Logout"
                    maxWidth="Infinity"
                    styleClass="logout-button"
                    onAction="#handleLogout"/>
        </VBox>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox styleClass="main-content">

                    <Label text="ADMIN / OVERVIEW"
                           styleClass="subtitle"/>

                    <Label text="Admin Dashboard"
                           styleClass="page-title"/>

                    <Label fx:id="nameLabel" text="Welcome back, Administrator!"
                           styleClass="subtitle"/>

                    <GridPane hgap="20" vgap="20">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox styleClass="dashboard-card"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0">

                            <Label text="👥" style="-fx-font-size: 32px;"/>
                            <Label text="User Profiles"
                                   styleClass="card-title"/>

                            <Label text="Create and maintain user accounts"
                                   styleClass="card-description"
                                   wrapText="true"/>

                            <Button text="Manage Users →"
                                    styleClass="card-button"
                                    onAction="#handleUsers"/>
                        </VBox>

                        <VBox styleClass="dashboard-card"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0">

                            <Label text="📚" style="-fx-font-size: 32px;"/>
                            <Label text="Courses"
                                   styleClass="card-title"/>

                            <Label text="Create and maintain faculty courses"
                                   styleClass="card-description"
                                   wrapText="true"/>

                            <Button text="Manage Courses →"
                                    styleClass="card-button"
                                    onAction="#handleCourses"/>
                        </VBox>

                        <VBox styleClass="dashboard-card"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1">

                            <Label text="📢" style="-fx-font-size: 32px;"/>
                            <Label text="Notices"
                                   styleClass="card-title"/>

                            <Label text="Create and maintain announcements"
                                   styleClass="card-description"
                                   wrapText="true"/>

                            <Button text="Manage Notices →"
                                    styleClass="card-button"
                                    onAction="#handleNotices"/>
                        </VBox>

                        <VBox styleClass="dashboard-card"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">

                            <Label text="📅" style="-fx-font-size: 32px;"/>
                            <Label text="Timetables"
                                   styleClass="card-title"/>

                            <Label text="Manage teaching schedules"
                                   styleClass="card-description"
                                   wrapText="true"/>

                            <Button text="Manage Timetables →"
                                    styleClass="card-button"
                                    onAction="#handleTimetables"/>
                        </VBox>

                        <VBox styleClass="dashboard-card"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="2">

                            <Label text="▤" style="-fx-font-size: 32px;"/>
                            <Label text="Course Offerings"
                                   styleClass="card-title"/>

                            <Label text="Manage semester course offerings, groups and offering statuses."
                                   styleClass="card-description"
                                   wrapText="true"/>

                            <Button text="Manage Course Offerings"
                                    styleClass="card-button"
                                    wrapText="true"
                                    onAction="#handleCourseOfferings"/>
                        </VBox>

                        <VBox styleClass="dashboard-card" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Student Enrollments" styleClass="card-title"/>
                            <Label text="Enroll students in course offerings and manage enrollment status."
                                   styleClass="card-description" wrapText="true"/>
                            <Button text="Manage Student Enrollments" styleClass="card-button"
                                    wrapText="true" onAction="#handleEnrollments"/>
                        </VBox>
                        <VBox styleClass="dashboard-card" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="SGPA / CGPA Management" styleClass="card-title"/>
                            <Label text="Calculate and save full student GPA using published results."
                                   styleClass="card-description" wrapText="true"/>
                            <Button id="gpaCardButton" text="Manage SGPA / CGPA" styleClass="card-button"
                                    wrapText="true" onAction="#handleGpa"/>
                        </VBox>
                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
