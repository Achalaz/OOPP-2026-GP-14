
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="medicalRoot"
            fx:controller="lk.ac.ruhuna.ftms.controller.MedicalController"
            prefWidth="1100"
            prefHeight="760">

    <!-- Header -->
    <top>
        <VBox spacing="5"
              style="-fx-background-color: #1f2937;">

            <padding>
                <Insets top="20" right="25"
                        bottom="20" left="25"/>
            </padding>

            <Label text="Medical Management"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="FTMS - Student Medical Management"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #d1d5db;"/>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="AS_NEEDED">

            <content>
                <VBox spacing="20">

                    <padding>
                        <Insets top="20" right="25"
                                bottom="25" left="25"/>
                    </padding>

                    <!-- Medical Request Details -->
                    <VBox spacing="12"
                          style="-fx-border-color: #d1d5db;
                                 -fx-border-radius: 6;
                                 -fx-padding: 15;">

                        <Label text="Medical Request Details"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="14" vgap="12">

                            <columnConstraints>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="190"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="190"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <!-- Medical ID -->
                            <Label text="Medical ID"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="medicalIdField"
                                       promptText="Medical ID"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                            <!-- Student ID -->
                            <Label text="Student ID *"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="studentIdField"
                                       promptText="Enter student ID"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="0"/>

                            <!-- Offering ID -->
                            <Label text="Offering ID"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                            <TextField fx:id="offeringIdField"
                                       promptText="Optional"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                            <!-- From Date -->
                            <Label text="From Date *"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="1"/>

                            <DatePicker fx:id="fromDatePicker"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="1"/>

                            <!-- To Date -->
                            <Label text="To Date *"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2"/>

                            <DatePicker fx:id="toDatePicker"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"/>

                            <!-- Reason -->
                            <Label text="Reason"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="3"/>

                            <TextArea fx:id="reasonArea"
                                      promptText="Enter medical reason"
                                      prefRowCount="3"
                                      wrapText="true"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="3"
                                      GridPane.columnSpan="3"/>

                            <!-- Document -->
                            <Label text="Document Path"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4"/>

                            <TextField fx:id="documentPathField"
                                       promptText="Select medical document"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="4"
                                       GridPane.columnSpan="2"/>

                            <Button text="Browse..."
                                    onAction="#handleBrowseDocument"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="4"/>

                        </GridPane>

                        <!-- Medical Buttons -->
                        <FlowPane hgap="10" vgap="10">

                            <Button text="Submit Medical"
                                    onAction="#handleSubmitMedical"/>

                            <Button text="Update Pending"
                                    onAction="#handleUpdateMedical"/>

                            <Button text="Find by Medical ID"
                                    onAction="#handleFindMedical"/>

                            <Button text="Load Student Medicals"
                                    onAction="#handleLoadStudentMedicals"/>

                            <Button text="Load All Medicals"
                                    onAction="#handleLoadAllMedicals"/>

                            <Button text="Delete Pending"
                                    onAction="#handleDeleteMedical"/>

                            <Button text="Clear"
                                    onAction="#handleClear"/>

                        </FlowPane>

                    </VBox>

                    <!-- Medical Review -->
                    <VBox spacing="12"
                          style="-fx-border-color: #d1d5db;
                                 -fx-border-radius: 6;
                                 -fx-padding: 15;">

                        <Label text="Medical Review"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Enter a valid reviewer ID for testing."
                               wrapText="true"/>

                        <GridPane hgap="14" vgap="12">

                            <columnConstraints>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="300"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <!-- Reviewer ID -->
                            <Label text="Reviewer ID *"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="reviewerIdField"
                                       promptText="Enter staff user ID"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                            <!-- Review Note -->
                            <Label text="Review Note"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                            <TextArea fx:id="reviewNoteArea"
                                      promptText="Enter review note"
                                      prefRowCount="2"
                                      wrapText="true"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1"/>

                        </GridPane>

                        <!-- Approve / Reject -->
                        <HBox spacing="10">

                            <Button text="Approve Medical"
                                    onAction="#handleApproveMedical"/>

                            <Button text="Reject Medical"
                                    onAction="#handleRejectMedical"/>

                        </HBox>

                    </VBox>

                    <!-- Medical Records Table -->
                    <VBox spacing="10">

                        <Label text="Medical Records"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Select a record to view its details."
                               wrapText="true"/>

                        <TableView fx:id="medicalTable"
                                   prefHeight="260">

                            <columns>

                                <TableColumn fx:id="medicalIdColumn"
                                             text="Medical ID"
                                             prefWidth="100"/>

                                <TableColumn fx:id="studentIdColumn"
                                             text="Student ID"
                                             prefWidth="110"/>

                                <TableColumn fx:id="periodColumn"
                                             text="Medical Period"
                                             prefWidth="240"/>

                                <TableColumn fx:id="reasonColumn"
                                             text="Reason"
                                             prefWidth="330"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox style="-fx-background-color: #f3f4f6;
                     -fx-padding: 12;">

            <Label fx:id="statusLabel"
                   text="Medical Management Ready"
                   wrapText="true"
                   style="-fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>
