<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="medicalRoot"
            fx:controller="lk.ac.ruhuna.ftms.controller.MedicalController"
            prefWidth="1100"
            prefHeight="760">

    <!-- HEADER -->
    <top>
        <VBox spacing="5"
              style="-fx-background-color: #1f2937;">

            <padding>
                <Insets top="20" right="25"
                        bottom="20" left="25"/>
            </padding>

            <Button text="Back to Dashboard"
                    onAction="#handleBack"/>

            <Label text="Medical Management"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="FTMS - Student Medical Management"
                   style="-fx-font-size: 13px; -fx-text-fill: #d1d5db;"/>

        </VBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="AS_NEEDED">

            <content>
                <VBox spacing="20">

                    <padding>
                        <Insets top="20" right="25"
                                bottom="25" left="25"/>
                    </padding>

                    <!-- MEDICAL REQUEST DETAILS -->
                    <VBox spacing="12"
                          style="-fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 15;">

                        <Label text="Medical Request Details"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <GridPane hgap="14" vgap="12">

                            <columnConstraints>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="190" hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="190" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Medical ID"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="medicalIdField"
                                       promptText="Medical ID"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                            <Label text="Student ID *"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="studentIdField"
                                       promptText="Enter student ID"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="0"/>

                            <Label text="Offering ID"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                            <TextField fx:id="offeringIdField"
                                       promptText="Optional"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                            <Label text="From Date *"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="1"/>

                            <DatePicker fx:id="fromDatePicker"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="1"/>

                            <Label text="To Date *"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2"/>

                            <DatePicker fx:id="toDatePicker"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"/>

                            <Label text="Reason"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="3"/>

                            <TextArea fx:id="reasonArea"
                                      promptText="Enter medical reason"
                                      prefRowCount="3"
                                      wrapText="true"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="3"
                                      GridPane.columnSpan="3"/>

                            <Label text="Document Path"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4"/>

                            <TextField fx:id="documentPathField"
                                       promptText="Select medical document"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="4"
                                       GridPane.columnSpan="2"/>

                            <Button text="Browse..."
                                    onAction="#handleBrowseDocument"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="4"/>

                        </GridPane>

                        <!-- MEDICAL CRUD BUTTONS -->
                        <FlowPane hgap="10" vgap="10">

                            <Button text="Submit Medical"
                                    onAction="#handleSubmitMedical"/>

                            <Button text="Update Pending"
                                    onAction="#handleUpdateMedical"/>

                            <Button text="Find by Medical ID"
                                    onAction="#handleFindMedical"/>

                            <Button text="Load Student Medicals"
                                    onAction="#handleLoadStudentMedicals"/>

                            <Button text="Load All Medicals"
                                    onAction="#handleLoadAllMedicals"/>

                            <Button text="Delete Pending"
                                    onAction="#handleDeleteMedical"/>

                            <Button text="Clear"
                                    onAction="#handleClear"/>

                        </FlowPane>

                    </VBox>

                    <!-- MEDICAL REVIEW -->
                    <VBox spacing="12"
                          style="-fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 15;">

                        <Label text="Medical Review"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="Enter a valid reviewer ID for testing."
                               wrapText="true"/>

                        <GridPane hgap="14" vgap="12">

                            <columnConstraints>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Reviewer ID *"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="reviewerIdField"
                                       promptText="Enter staff user ID"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                            <Label text="Review Note"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                            <TextArea fx:id="reviewNoteArea"
                                      promptText="Enter review note"
                                      prefRowCount="2"
                                      wrapText="true"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1"/>

                        </GridPane>

                        <HBox spacing="10">

                            <Button text="Approve Medical"
                                    onAction="#handleApproveMedical"/>

                            <Button text="Reject Medical"
                                    onAction="#handleRejectMedical"/>

                        </HBox>
                    </VBox>

                    <!-- STEP 20: MEDICAL ATTENDANCE LINKING -->
                    <VBox fx:id="medicalLinkSection"
                          spacing="10"
                          style="-fx-background-color: #eef5fd; -fx-background-radius: 8; -fx-padding: 15;">

                        <Label text="Medical - Attendance Absence Linking"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="Select a medical record, load matching absences, then link or unlink an attendance record. Only Technical Officers can perform linking. Raw attendance percentage does not change."
                               wrapText="true"/>

                        <FlowPane hgap="10" vgap="10">

                            <Button text="Load Matching Absences"
                                    onAction="#handleLoadMedicalAbsences"/>

                            <Button text="Link Selected Absence"
                                    onAction="#handleLinkMedicalAbsence"/>

                            <Button text="Unlink Selected Absence"
                                    onAction="#handleUnlinkMedicalAbsence"/>

                        </FlowPane>

                        <TableView fx:id="absenceTable"
                                   prefHeight="205">

                            <columns>

                                <TableColumn fx:id="absenceIdColumn"
                                             text="Attendance ID"
                                             prefWidth="120"/>

                                <TableColumn fx:id="absenceDateColumn"
                                             text="Date"
                                             prefWidth="125"/>

                                <TableColumn fx:id="absenceTypeColumn"
                                             text="Session Type"
                                             prefWidth="120"/>

                                <TableColumn fx:id="absenceStatusColumn"
                                             text="Status"
                                             prefWidth="115"/>

                                <TableColumn fx:id="linkedMedicalColumn"
                                             text="Linked Medical"
                                             prefWidth="145"/>

                            </columns>
                        </TableView>

                    </VBox>

                    <!-- MEDICAL RECORDS TABLE -->
                    <VBox spacing="10">

                        <Label text="Medical Records"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="Select a record to view its details."
                               wrapText="true"/>

                        <TableView fx:id="medicalTable"
                                   prefHeight="260">

                            <columns>

                                <TableColumn fx:id="medicalIdColumn"
                                             text="Medical ID"
                                             prefWidth="100"/>

                                <TableColumn fx:id="studentIdColumn"
                                             text="Student ID"
                                             prefWidth="110"/>

                                <TableColumn fx:id="periodColumn"
                                             text="Medical Period"
                                             prefWidth="240"/>

                                <TableColumn fx:id="reasonColumn"
                                             text="Reason"
                                             prefWidth="330"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="130"/>

                            </columns>
                        </TableView>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <HBox style="-fx-background-color: #f3f4f6; -fx-padding: 12;">

            <Label fx:id="statusLabel"
                   text="Medical Management Ready"
                   wrapText="true"
                   style="-fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>
