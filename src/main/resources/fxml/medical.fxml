
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="medicalRoot"
            fx:controller="lk.ac.ruhuna.ftms.controller.MedicalController"
            prefWidth="1100"
            prefHeight="760"
            style="-fx-background-color: #f8fafc;">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              style="-fx-background-color: #1f2937; -fx-padding: 18 25;">

            <VBox spacing="5">
                <Label text="Medical Management"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Label text="TECHNICAL OFFICER | Your department only"
                       style="-fx-font-size: 12px; -fx-text-fill: #d1d5db;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back to Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER">

            <content>
                <VBox spacing="20"
                      style="-fx-padding: 20 25 25 25;">

                    <!-- MEDICAL REQUEST FORM -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 15;">

                        <Label text="Medical Request Details"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="Select a row to edit a pending medical, or clear the form to create a new one."
                               wrapText="true"
                               style="-fx-text-fill: #64748b;"/>

                        <GridPane hgap="14" vgap="12">

                            <columnConstraints>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="190"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="125"/>
                                <ColumnConstraints minWidth="190"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <!-- MEDICAL ID -->
                            <Label text="Medical ID"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="medicalIdField"
                                       promptText="For Find / Update / Review / Delete"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                            <!-- STUDENT ID -->
                            <Label text="Student ID *"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="studentIdField"
                                       promptText="Enter student ID"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="0"/>

                            <!-- OFFERING ID -->
                            <Label text="Offering ID"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                            <TextField fx:id="offeringIdField"
                                       promptText="Optional; enrolled course offering"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                            <!-- FROM DATE -->
                            <Label text="From Date *"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="1"/>

                            <DatePicker fx:id="fromDatePicker"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="1"/>

                            <!-- TO DATE -->
                            <Label text="To Date *"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2"/>

                            <DatePicker fx:id="toDatePicker"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"/>

                            <!-- REASON -->
                            <Label text="Reason"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="3"/>

                            <TextArea fx:id="reasonArea"
                                      prefRowCount="3"
                                      wrapText="true"
                                      promptText="Enter medical reason"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="3"
                                      GridPane.columnSpan="3"/>

                            <!-- DOCUMENT PATH -->
                            <Label text="Document Path"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4"/>

                            <TextField fx:id="documentPathField"
                                       promptText="Local file path (not uploaded)"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="4"
                                       GridPane.columnSpan="2"/>

                            <Button text="Browse..."
                                    onAction="#handleBrowseDocument"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="4"/>
                        </GridPane>

                        <!-- CRUD BUTTONS -->
                        <FlowPane hgap="10" vgap="10">

                            <Button text="Create Medical"
                                    onAction="#handleSubmitMedical"/>

                            <Button text="Update Pending"
                                    onAction="#handleUpdateMedical"/>

                            <Button text="Find by Medical ID"
                                    onAction="#handleFindMedical"/>

                            <Button text="Load Student Medicals"
                                    onAction="#handleLoadStudentMedicals"/>

                            <Button text="Load Department Medicals"
                                    onAction="#handleLoadAllMedicals"/>

                            <Button text="Delete Pending"
                                    onAction="#handleDeleteMedical"
                                    style="-fx-text-fill: #b91c1c;"/>

                            <Button text="Clear"
                                    onAction="#handleClear"/>
                        </FlowPane>

                    </VBox>

                    <!-- MEDICAL REVIEW -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 15;">

                        <Label text="Medical Review"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="The reviewer is automatically the logged-in Technical Officer. Only PENDING records can be reviewed."
                               wrapText="true"
                               style="-fx-text-fill: #64748b;"/>

                        <Label text="Review Note"/>

                        <TextArea fx:id="reviewNoteArea"
                                  prefRowCount="2"
                                  wrapText="true"
                                  promptText="Optional review note"/>

                        <HBox spacing="10">

                            <Button text="Approve Medical"
                                    onAction="#handleApproveMedical"
                                    style="-fx-background-color: #15803d; -fx-text-fill: white;"/>

                            <Button text="Reject Medical"
                                    onAction="#handleRejectMedical"
                                    style="-fx-background-color: #b91c1c; -fx-text-fill: white;"/>

                        </HBox>
                    </VBox>

                    <!-- MEDICAL RECORDS TABLE -->
                    <VBox spacing="10"
                          style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 15;">

                        <Label text="Department Medical Records"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="Select a record to populate the form."
                               style="-fx-text-fill: #64748b;"/>

                        <TableView fx:id="medicalTable"
                                   prefHeight="260">

                            <columns>
                                <TableColumn fx:id="medicalIdColumn"
                                             text="Medical ID"
                                             prefWidth="100"/>

                                <TableColumn fx:id="studentIdColumn"
                                             text="Student ID"
                                             prefWidth="110"/>

                                <TableColumn fx:id="periodColumn"
                                             text="Medical Period"
                                             prefWidth="240"/>

                                <TableColumn fx:id="reasonColumn"
                                             text="Reason"
                                             prefWidth="330"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <HBox style="-fx-background-color: #e2e8f0; -fx-padding: 12;">

            <Label fx:id="statusLabel"
                   text="Loading department medicals..."
                   wrapText="true"
                   style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>

        </HBox>
    </bottom>

</BorderPane>
