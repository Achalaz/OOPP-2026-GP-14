<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="lk.ac.ruhuna.ftms.controller.LoginController"
           fx:id="loginRoot"
           prefWidth="1200"
           prefHeight="700">

    <!-- Background -->
    <ImageView fx:id="backgroundImage"
               fitWidth="1200"
               fitHeight="700"
               preserveRatio="false">
        <image>
            <Image url="@../images/faculty_background.png"/>
        </image>
    </ImageView>

    <!-- Login panel -->
    <HBox alignment="CENTER_RIGHT"
          style="-fx-padding: 50;">

        <VBox alignment="CENTER_LEFT"
              spacing="18"
              prefWidth="380"
              maxWidth="380"
              style="-fx-background-color: rgba(8,25,50,0.93);
                     -fx-background-radius: 15;
                     -fx-padding: 35;">

            <Label text="WELCOME BACK"
                   style="-fx-text-fill: #a8d5ff;
                          -fx-font-size: 14;"/>

            <Label text="FTMS LOGIN"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28;
                          -fx-font-weight: bold;"/>

            <Label text="Faculty Technology Management System"
                   wrapText="true"
                   style="-fx-text-fill: #dddddd;
                          -fx-font-size: 13;"/>

            <!-- Username -->
            <Label text="Username"
                   style="-fx-text-fill: white;"/>

            <TextField fx:id="usernameField"
                       promptText="Enter username"
                       prefHeight="42"/>

            <!-- Password -->
            <Label text="Password"
                   style="-fx-text-fill: white;"/>

            <StackPane prefHeight="42">

                <PasswordField fx:id="passwordField"
                               promptText="Enter password"
                               prefHeight="42"
                               style="-fx-padding: 0 50 0 12;"/>

                <TextField fx:id="visiblePasswordField"
                           promptText="Enter password"
                           prefHeight="42"
                           visible="false"
                           managed="false"
                           style="-fx-padding: 0 50 0 12;"/>

                <!-- Custom PNG eye button -->
                <Button fx:id="eyeButton"
                        onAction="#togglePasswordVisibility"
                        prefWidth="44"
                        prefHeight="42"
                        focusTraversable="false"
                        StackPane.alignment="CENTER_RIGHT"
                        style="-fx-background-color: transparent;
                               -fx-padding: 0;
                               -fx-cursor: hand;">

                    <graphic>
                        <ImageView fx:id="eyeIcon"
                                   fitWidth="24"
                                   fitHeight="24"
                                   preserveRatio="true"/>
                    </graphic>

                </Button>

            </StackPane>

            <!-- Validation -->
            <Label fx:id="messageLabel"
                   wrapText="true"
                   minHeight="20"
                   style="-fx-text-fill: #ff9999;
                          -fx-font-size: 12;"/>

            <!-- Login button -->
            <Button fx:id="loginButton"
                    text="LOGIN"
                    onAction="#handleLogin"
                    defaultButton="true"
                    prefHeight="45"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1683dc;
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

            <Label text="University of Ruhuna"
                   style="-fx-text-fill: #bbbbbb;
                          -fx-font-size: 12;"/>

        </VBox>
    </HBox>

</StackPane>
