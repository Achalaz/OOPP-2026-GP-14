<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="lk.ac.ruhuna.ftms.controller.LoginController"
           fx:id="loginRoot"
           prefWidth="1200"
           prefHeight="700">

    <!-- Faculty background image -->
    <ImageView fx:id="backgroundImage"
               fitWidth="1200"
               fitHeight="700"
               preserveRatio="false">

        <image>
            <Image url="@../images/faculty_background.png"/>
        </image>

    </ImageView>

    <!-- Login form on the right -->
    <HBox alignment="CENTER_RIGHT"
          style="-fx-padding: 50;">

        <VBox alignment="CENTER_LEFT"
              spacing="18"
              prefWidth="350"
              maxWidth="350"
              style="-fx-background-color: rgba(8, 25, 50, 0.93);
                     -fx-background-radius: 15;
                     -fx-padding: 35;">

            <Label text="WELCOME BACK"
                   style="-fx-text-fill: #a8d5ff;
                          -fx-font-size: 14;"/>

            <Label text="FTMS LOGIN"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28;
                          -fx-font-weight: bold;"/>

            <Label text="Faculty Technology Management System"
                   wrapText="true"
                   style="-fx-text-fill: #dddddd;
                          -fx-font-size: 13;"/>

            <Label text="Username"
                   style="-fx-text-fill: white;"/>

            <TextField fx:id="usernameField"
                       promptText="Enter username"
                       prefHeight="42"/>

            <Label text="Password"
                   style="-fx-text-fill: white;"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter password"
                           prefHeight="42"/>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   style="-fx-text-fill: #ff9999;"/>

            <Button text="LOGIN"
                    onAction="#handleLogin"
                    defaultButton="true"
                    prefHeight="45"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1683dc;
                           -fx-text-fill: white;
                           -fx-font-size: 15;
                           -fx-font-weight: bold;"/>

            <Label text="University of Ruhuna"
                   style="-fx-text-fill: #bbbbbb;
                          -fx-font-size: 12;"/>

        </VBox>

    </HBox>

</StackPane>