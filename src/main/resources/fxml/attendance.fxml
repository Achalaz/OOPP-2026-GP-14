<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="attendanceRoot"
            fx:controller="lk.ac.ruhuna.ftms.controller.AttendanceController"
            prefWidth="1100" prefHeight="700" minWidth="0"
            style="-fx-background-color: #f4f8fc; -fx-font-family: 'Segoe UI';">
    <top>
        <VBox spacing="10" style="-fx-background-color: #102b4e; -fx-padding: 18 24;">
            <FlowPane hgap="12" vgap="8">
                <Button text="Back to Dashboard" onAction="#handleBack"/>
                <Button text="Logout" onAction="#handleLogout"/>
            </FlowPane>
            <Label text="Attendance Management" wrapText="true"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Technical Officer Portal · Undergraduate attendance"
                   wrapText="true" style="-fx-text-fill: #cbdcf0;"/>
            <Label fx:id="statusLabel" text="Loading active course offerings..."
                   wrapText="true" style="-fx-text-fill: #ffffff;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0">
            <VBox fx:id="workspace" spacing="20" minWidth="0">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <VBox spacing="10" minWidth="0">
                    <Label text="1. Select a course offering" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="offeringCombo" promptText="Choose an active course offering"
                              maxWidth="Infinity" minWidth="0"/>
                </VBox>
                <!-- Reuses the existing Attendance Session workflow. -->
                <VBox spacing="12" minWidth="0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18;">
                    <Label text="2. Create an attendance session"
                           style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                    <FlowPane hgap="16" vgap="12">
                        <VBox spacing="6" prefWidth="190">
                            <Label text="Session date"/>
                            <DatePicker fx:id="sessionDatePicker" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="190">
                            <Label text="Start time"/>
                            <TextField fx:id="startTimeField" promptText="09:00 (HH:mm)"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="190">
                            <Label text="End time"/>
                            <TextField fx:id="endTimeField" promptText="11:00 (HH:mm)"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="190">
                            <Label text="Session type"/>
                            <ComboBox fx:id="sessionTypeCombo" promptText="Select session type" maxWidth="Infinity"/>
                        </VBox>
                    </FlowPane>
                    <Label text="Topic (optional)"/>
                    <TextField fx:id="topicField" promptText="Session topic" minWidth="0"/>
                    <Button text="Save Session" onAction="#handleSaveSession" prefWidth="160"/>
                </VBox>
                <VBox spacing="12" minWidth="0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18;">
                    <Label text="3. Mark or update student attendance"
                           wrapText="true" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                    <Label text="Existing session"/>
                    <ComboBox fx:id="sessionCombo" promptText="Select a saved attendance session"
                              maxWidth="Infinity" minWidth="0"/>
                    <Label text="Undergraduate enrollment"/>
                    <ComboBox fx:id="enrollmentCombo" promptText="Select an enrolled undergraduate"
                              maxWidth="Infinity" minWidth="0"/>
                    <Label text="Attendance status"/>
                    <ComboBox fx:id="attendanceStatusCombo" promptText="Select status"
                              maxWidth="Infinity" minWidth="0"/>
                    <FlowPane hgap="10" vgap="10">
                        <Button text="Save / Update Attendance" onAction="#handleSaveAttendance"/>
                        <Button text="Load Attendance" onAction="#handleLoadAttendance"/>
                        <Button text="Clear" onAction="#handleClear"/>
                    </FlowPane>
                </VBox>
                <!-- Attendance Records -->
                <VBox spacing="10">

                    <Label text="Attendance Records"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;"/>

                    <TableView fx:id="attendanceTable"
                               prefHeight="250" minWidth="0">

                        <columns>
                            <TableColumn fx:id="enrollmentColumn"
                                         text="Enrollment ID"
                                         prefWidth="250"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Attendance Status"
                                         prefWidth="300"/>
                        </columns>

                    </TableView>
                </VBox>

                <!-- NEW Attendance Summary Section -->
                <VBox spacing="10"
                      style="-fx-border-color: #d1d5db;
                             -fx-border-radius: 5;
                             -fx-padding: 15;">

                    <Label text="Attendance Summary - Theory / Practical / Combined" wrapText="true"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Select a course offering above, then select Load Batch Summary. Click a row to view an individual. Only PRESENT currently counts as attended."
                           wrapText="true"/>

                    <Button text="Load Batch Summary"
                            onAction="#handleLoadSummary"
                            prefWidth="180"/>

                    <TableView fx:id="summaryTable"
                               prefHeight="250">

                        <columns>

                            <TableColumn fx:id="summaryEnrollmentColumn"
                                         text="Enrollment"
                                         prefWidth="95"/>

                            <TableColumn fx:id="summaryRegistrationColumn"
                                         text="Registration No"
                                         prefWidth="140"/>

                            <TableColumn fx:id="summaryStudentColumn"
                                         text="Student"
                                         prefWidth="170"/>

                            <TableColumn fx:id="summaryTheoryColumn"
                                         text="Theory (P/T)"
                                         prefWidth="130"/>

                            <TableColumn fx:id="summaryPracticalColumn"
                                         text="Practical (P/T)"
                                         prefWidth="130"/>

                            <TableColumn fx:id="summaryCombinedColumn"
                                         text="Combined (P/T)"
                                         prefWidth="135"/>

                            <TableColumn fx:id="summaryMedicalColumn"
                                         text="Medical"
                                         prefWidth="70"/>

                            <TableColumn fx:id="summaryUnmarkedColumn"
                                         text="Unmarked"
                                         prefWidth="85"/>

                        </columns>
                    </TableView>

                    <Label fx:id="summaryDetailsLabel"
                           text="Select a student to view individual attendance details."
                           wrapText="true"/>

                </VBox>


            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
