<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ac.ruhuna.ftms.controller.ReportsController"
            prefWidth="1280.0"
            prefHeight="760.0"
            style="-fx-background-color: #f4f6f8;">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: #1f2937; -fx-padding: 18;">

            <Button fx:id="backButton"
                    text="← Back"
                    onAction="#handleBack"
                    style="-fx-background-color: #374151;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Label text="Results Reports"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

        </HBox>
    </top>

    <center>

        <VBox spacing="16"
              style="-fx-padding: 20;">

            <!-- REPORT SELECTION AREA -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 18;
                         -fx-background-radius: 10;
                         -fx-border-color: #d1d5db;
                         -fx-border-radius: 10;">

                <Label text="Report Selection"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #111827;"/>

                <GridPane hgap="15"
                          vgap="12">

                    <Label text="Student:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>

                    <ComboBox fx:id="studentCombo"
                              promptText="Select Student"
                              prefWidth="350"
                              GridPane.rowIndex="0"
                              GridPane.columnIndex="1"/>

                    <Button fx:id="studentReportButton"
                            text="Load Student Report"
                            onAction="#handleStudentReport"
                            prefWidth="170"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="2"
                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;"/>

                    <Label text="Course Offering:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;"/>

                    <ComboBox fx:id="offeringCombo"
                              promptText="Select Course Offering"
                              prefWidth="350"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"/>

                    <Button fx:id="offeringReportButton"
                            text="Load Batch Report"
                            onAction="#handleOfferingReport"
                            prefWidth="170"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="2"
                            style="-fx-background-color: #059669;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;"/>

                </GridPane>
            </VBox>

            <!-- SUMMARY CARDS -->
            <HBox spacing="12">

                <VBox alignment="CENTER"
                      spacing="5"
                      prefWidth="170"
                      style="-fx-background-color: white;
                             -fx-padding: 12;
                             -fx-background-radius: 8;
                             -fx-border-color: #d1d5db;
                             -fx-border-radius: 8;">

                    <Label text="Total"
                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="totalLabel"
                           text="0"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="5"
                      prefWidth="170"
                      style="-fx-background-color: white;
                             -fx-padding: 12;
                             -fx-background-radius: 8;
                             -fx-border-color: #d1d5db;
                             -fx-border-radius: 8;">

                    <Label text="Passed"
                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="passLabel"
                           text="0"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #059669;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="5"
                      prefWidth="170"
                      style="-fx-background-color: white;
                             -fx-padding: 12;
                             -fx-background-radius: 8;
                             -fx-border-color: #d1d5db;
                             -fx-border-radius: 8;">

                    <Label text="Failed"
                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="failLabel"
                           text="0"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #dc2626;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="5"
                      prefWidth="170"
                      style="-fx-background-color: white;
                             -fx-padding: 12;
                             -fx-background-radius: 8;
                             -fx-border-color: #d1d5db;
                             -fx-border-radius: 8;">

                    <Label text="Pending"
                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="pendingLabel"
                           text="0"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #f59e0b;"/>
                </VBox>

                <VBox alignment="CENTER"
                      spacing="5"
                      prefWidth="190"
                      style="-fx-background-color: white;
                             -fx-padding: 12;
                             -fx-background-radius: 8;
                             -fx-border-color: #d1d5db;
                             -fx-border-radius: 8;">

                    <Label text="Average Overall Mark"
                           style="-fx-text-fill: #6b7280;"/>

                    <Label fx:id="averageLabel"
                           text="--"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2563eb;"/>
                </VBox>

            </HBox>

            <!-- REPORT TABLE -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-padding: 15;
                         -fx-background-radius: 10;
                         -fx-border-color: #d1d5db;
                         -fx-border-radius: 10;">

                <Label text="Report Data"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <TableView fx:id="reportTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="registrationColumn"
                                     text="Registration No"
                                     prefWidth="135"/>

                        <TableColumn fx:id="studentNameColumn"
                                     text="Student Name"
                                     prefWidth="170"/>

                        <TableColumn fx:id="courseCodeColumn"
                                     text="Course Code"
                                     prefWidth="110"/>

                        <TableColumn fx:id="courseNameColumn"
                                     text="Course Name"
                                     prefWidth="180"/>

                        <TableColumn fx:id="creditsColumn"
                                     text="Credits"
                                     prefWidth="75"/>

                        <TableColumn fx:id="caMarkColumn"
                                     text="CA Mark"
                                     prefWidth="90"/>

                        <TableColumn fx:id="finalMarkColumn"
                                     text="Final Mark"
                                     prefWidth="90"/>

                        <TableColumn fx:id="overallMarkColumn"
                                     text="Overall"
                                     prefWidth="90"/>

                        <TableColumn fx:id="gradeColumn"
                                     text="Grade"
                                     prefWidth="75"/>

                        <TableColumn fx:id="gradePointColumn"
                                     text="Grade Point"
                                     prefWidth="95"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="110"/>

                    </columns>

                </TableView>

            </VBox>

            <Separator/>

            <!-- ACTION AREA -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#handleRefresh"
                        prefWidth="110"
                        style="-fx-background-color: #f59e0b;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#handleClear"
                        prefWidth="100"
                        style="-fx-background-color: #6b7280;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="statusLabel"
                       text="Select a student or course offering."
                       style="-fx-text-fill: #4b5563;
                              -fx-font-style: italic;"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>