<mxfile host="app.diagrams.net">
  <diagram id="1gDgTGfdNXkPoTcVrjqK" name="Page-1">
    <mxGraphModel dx="2203" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;:&#39;base&#39;, &#39;themeVariables&#39;: {\n  &#39;primaryColor&#39;:&#39;#EFF6FF&#39;,\n  &#39;primaryTextColor&#39;:&#39;#1E293B&#39;,\n  &#39;primaryBorderColor&#39;:&#39;#3B82F6&#39;,\n  &#39;lineColor&#39;:&#39;#475569&#39;,\n  &#39;secondaryColor&#39;:&#39;#F0FDF4&#39;,\n  &#39;tertiaryColor&#39;:&#39;#F8FAFC&#39;,\n  &#39;fontFamily&#39;:&#39;Inter, \&quot;Noto Sans SC\&quot;, sans-serif&#39;,\n  &#39;fontSize&#39;:&#39;14px&#39;\n}}}%%\nclassDiagram\n    direction LR\n\n    %% ============ ABSTRACT USER HIERARCHY ============\n    class User {\n        &lt;&lt;abstract&gt;&gt;\n        -int userId\n        -String username\n        -String passwordHash\n        -String fullName\n        -String email\n        -String contactNo\n        -String role\n        -String accountStatus\n        +boolean login(String username, String password)\n        +void logout()\n        +abstract void updateProfile()\n        +List~Notice~ viewNotices()\n        #void validatePassword(String pwd) throws InvalidPasswordException\n    }\n\n    class Admin {\n        +User createUser(UserProfileDTO profile)\n        +void updateUser(int userId, UserProfileDTO profile)\n        +void deleteUser(int userId)\n        +Course createCourse(CourseDTO course)\n        +void updateCourse(int courseId, CourseDTO course)\n        +Notice createNotice(NoticeDTO notice)\n        +void updateNotice(int noticeId, NoticeDTO notice)\n        +Timetable createTimetable(TimetableDTO tt)\n        +void updateTimetable(int timetableId, TimetableDTO tt)\n        +void updateUserProfile(int userId, UserProfileDTO profile)\n    }\n\n    class Lecturer {\n        -int lecturerId\n        -String designation\n        -int departmentId\n        +void updateProfile()  %% polymorphism\n        +void addCourseMaterial(int offeringId, MaterialDTO m)\n        +void updateCourseMaterial(int materialId, MaterialDTO m)\n        +void uploadMarks(int offeringId, int assessmentId, Map marks)\n        +StudentDetails viewStudentDetails(int studentId)\n        +EligibilityStatus viewEligibility(int studentId)\n        +GradeReport viewGrades(int studentId)\n        +AttendanceReport viewAttendance(int studentId)\n        +List~Medical~ viewMedical(int studentId)\n    }\n\n    class TechnicalOfficer {\n        -int toId\n        -int departmentId\n        +void updateProfile()  %% polymorphism\n        +void recordAttendance(int sessionId, Map~int,String~ records)\n        +void updateAttendance(int attendanceId, String status)\n        +Medical submitMedical(MedicalDTO m)\n        +void updateMedicalStatus(int medicalId, String status)\n        +List~Timetable~ viewTimetable(int departmentId)\n    }\n\n    class Undergraduate {\n        -int studentId\n        -String registrationNo\n        -String batch\n        -String academicYear\n        -String studentStatus\n        +void updateProfile()  %% polymorphism - restricted\n        +void updateContactDetails(String email, String contactNo)\n        +void updateProfilePicture(String imagePath)\n        +AttendanceReport viewAttendance()\n        +List~Medical~ viewMedicals()\n        +List~Course~ viewCourses()\n        +GradeReport viewGrades()\n        +GPAReport viewGPA()\n        +List~Timetable~ viewTimetable()\n    }\n\n    User &lt;|-- Admin\n    User &lt;|-- Lecturer\n    User &lt;|-- TechnicalOfficer\n    User &lt;|-- Undergraduate\n\n    %% ============ ACADEMIC STRUCTURE ============\n    class Department {\n        -int departmentId\n        -String departmentName\n        +Department getDepartment(int id)\n        +List~Lecturer~ getLecturers()\n        +List~Course~ getCourses()\n    }\n\n    class Course {\n        -int courseId\n        -String courseCode\n        -String courseName\n        -int theoryCredits\n        -int practicalCredits\n        +void addCourse()\n        +void updateCourse()\n        +List~CourseOffering~ getOfferings()\n    }\n\n    class CourseOffering {\n        -int offeringId\n        -String semester\n        -String academicYear\n        -String batch\n        -int lecturerId\n        +void enrollStudent(int studentId)\n        +List~Enrollment~ getEnrollment()\n        +Timetable getTimetable()\n    }\n\n    class Enrollment {\n        -int enrollmentId\n        -int studentId\n        -int offeringId\n        -String enrollmentStatus\n        +void markEnrollment()\n        +boolean checkEligibility()\n    }\n\n    class CourseMaterial {\n        -int materialId\n        -String title\n        -String filePath\n        -Date uploadedAt\n        -int lecturerId\n        +void uploadMaterial()\n        +void downloadMaterial()\n    }\n\n    %% ============ ASSESSMENT &amp; MARKS ============\n    class Assessment {\n        -int assessmentId\n        -String assessmentName\n        -String assessmentType\n        -double weightPercentage\n        -int maximumMark\n        -String evaluationCriteria\n        +void addAssessment()\n        +void updateAssessment()\n    }\n\n    class Mark {\n        -int markId\n        -int enrollmentId\n        -int assessmentId\n        -double marksObtained\n        -int attemptNo\n        +void uploadMark()\n        +void updateMark()\n        +double calculateCAMark()\n    }\n\n    class CourseResult {\n        -int resultId\n        -int enrollmentId\n        -double caMark\n        -double finalMark\n        -double overallMark\n        -boolean caEligible\n        -boolean overallEligible\n        -String gradeLetter\n        -double gradePoint\n        +double calculateCA()\n        +boolean checkCAEligibility()\n        +boolean checkOverallEligibility()\n        +GradeRule determineGrade()\n    }\n\n    class SemesterResult {\n        -int semesterResultId\n        -int studentId\n        -String semester\n        -String academicYear\n        -double sgpa\n        -double cgpa\n        +double calculateSGPA()\n        +double calculateCGPA()\n        +List~CourseResult~ getCourseResults()\n    }\n\n    class GradeRule {\n        -int gradeRuleId\n        -String gradeLetter\n        -double minMark\n        -double maxMark\n        -double gradePoint\n        +String getGrade(double mark)\n        +double getGradePoint(String grade)\n    }\n\n    %% ============ ATTENDANCE &amp; MEDICAL ============\n    class AttendanceSession {\n        -int sessionId\n        -int offeringId\n        -int timetableId\n        -String sessionType\n        -Date sessionDate\n        -int sessionNumber\n        -Date recordedAt\n        +void recordSession()\n        +AttendanceSession getSession()\n    }\n\n    class AttendanceRecord {\n        -int attendanceId\n        -int studentId\n        -int sessionId\n        -String status\n        -Date recordedAt\n        +void markAttendance(String status)\n        +void updateAttendance(String status)\n        +double calculateAttendancePercentage()\n    }\n\n    class Medical {\n        -int medicalId\n        -int studentId\n        -int recordedBy\n        -Date medicalDate\n        -String supportingDocumentPath\n        -String approvalStatus\n        +void submitMedical()\n        +void approveMedical()\n        +void rejectMedical()\n        +boolean isApproved()\n    }\n\n    %% ============ NOTICE &amp; TIMETABLE ============\n    class Notice {\n        -int noticeId\n        -String title\n        -String description\n        -String targetRole\n        -Date postedAt\n        -int postedBy\n        +void postNotice()\n        +void updateNotice()\n        +void deleteNotice()\n    }\n\n    class Timetable {\n        -int timetableId\n        -int offeringId\n        -String dayOfWeek\n        -Time startTime\n        -Time endTime\n        -String sessionType\n        -String lectureHall\n        +void addToTimetable()\n        +void updateTimetable()\n        +List~Timetable~ getWeeklyTimetable()\n    }\n\n    %% ============ RELATIONSHIPS ============\n    Department \&quot;1\&quot; --|&gt; \&quot;N\&quot; Lecturer : employs\n    Department \&quot;1\&quot; --|&gt; \&quot;N\&quot; TechnicalOfficer : employs\n    Department \&quot;1\&quot; --|&gt; \&quot;N\&quot; Course : offers\n\n    Course \&quot;1\&quot; --|&gt; \&quot;N\&quot; CourseOffering : \&quot;offered as\&quot;\n    CourseOffering \&quot;1\&quot; --|&gt; \&quot;N\&quot; Enrollment : has\n    CourseOffering \&quot;1\&quot; --&gt; \&quot;1\&quot; Lecturer : \&quot;taught by\&quot;\n    CourseOffering \&quot;1\&quot; --|&gt; \&quot;N\&quot; CourseMaterial : has\n    CourseOffering \&quot;1\&quot; --|&gt; \&quot;N\&quot; Timetable : \&quot;scheduled in\&quot;\n\n    Undergraduate \&quot;1\&quot; --|&gt; \&quot;N\&quot; Enrollment : submits\n    Undergraduate \&quot;1\&quot; --|&gt; \&quot;N\&quot; AttendanceRecord : has\n    Undergraduate \&quot;1\&quot; --|&gt; \&quot;N\&quot; Medical : submits\n    Undergraduate \&quot;1\&quot; --|&gt; \&quot;N\&quot; SemesterResult : produces\n\n    Enrollment \&quot;1\&quot; --|&gt; \&quot;N\&quot; Mark : has\n    Enrollment \&quot;1\&quot; --&gt; \&quot;1\&quot; CourseResult : produces\n    CourseOffering \&quot;1\&quot; --|&gt; \&quot;N\&quot; Assessment : has\n\n    Assessment \&quot;1\&quot; --|&gt; \&quot;N\&quot; Mark : for\n    Mark \&quot;N\&quot; --&gt; \&quot;1\&quot; Enrollment : belongs to\n\n    CourseResult \&quot;N\&quot; --&gt; \&quot;1\&quot; GradeRule : \&quot;determines\&quot;\n    SemesterResult \&quot;N\&quot; --&gt; \&quot;N\&quot; CourseResult : \&quot;aggregates\&quot;\n\n    CourseOffering \&quot;1\&quot; --|&gt; \&quot;N\&quot; AttendanceSession : has\n    AttendanceSession \&quot;1\&quot; --|&gt; \&quot;N\&quot; AttendanceRecord : records\n    Timetable \&quot;1\&quot; --&gt; \&quot;N\&quot; AttendanceSession : \&quot;generates\&quot;\n\n    Medical \&quot;1\&quot; --&gt; \&quot;N\&quot; AttendanceSession : \&quot;covers\&quot;\n    TechnicalOfficer \&quot;1\&quot; --|&gt; \&quot;N\&quot; Medical : \&quot;records\&quot;\n    TechnicalOfficer \&quot;1\&quot; --|&gt; \&quot;N\&quot; AttendanceRecord : \&quot;records\&quot;\n\n    Lecturer \&quot;1\&quot; --|&gt; \&quot;N\&quot; CourseMaterial : uploads\n    Lecturer \&quot;1\&quot; --|&gt; \&quot;N\&quot; Mark : uploads\n\n    Admin \&quot;1\&quot; --|&gt; \&quot;N\&quot; Notice : posts\n    Admin \&quot;1\&quot; --|&gt; \&quot;N\&quot; Timetable : maintains\n    Admin \&quot;1\&quot; --|&gt; \&quot;N\&quot; Course : maintains\n\n    Notice \&quot;N\&quot; --&gt; \&quot;1\&quot; User : \&quot;targeted to\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="322">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
